SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudinary dashboard-dan (Dashboard səhifəsinin yuxarısından) götürün.
# Dev-də CLOUDINARY_CLOUD_NAME təyin olunsa, elan şəkillərinə watermark logo
# tətbiq olunur (bax: listings/models.py); API_KEY/SECRET yalnız
# `manage.py upload_watermark_logo` əmri üçün lazımdır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# https://www.pexels.com/api/ - yalnız `manage.py seed_data` üçün lazımdır
# (demo elanlara real əmlak fotoları çəkmək üçün). Boş olsa, sadə placeholder
# şəkillər istifadə olunur.
PEXELS_API_KEY=
